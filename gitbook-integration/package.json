{
  "name": "pixel-foundry-gitbook-integration",
  "private": true,
  "type": "module",
  "description": "Live Pixel Foundry demos for the docs: the frames GitHub Pages serves, and the GitBook block that embeds them.",
  "scripts": {
    "build": "node scripts/build-pages.mjs",
    "preview": "node scripts/build-pages.mjs && node scripts/preview.mjs",
    "typecheck": "tsc -p tsconfig.json && tsc -p frame/tsconfig.json",
    "publish-integration": "node scripts/require-organization.mjs && gitbook integration publish"
  },
  "dependencies": {
    "@gitbook/api": "^0.212.0",
    "@gitbook/runtime": "^0.26.1"
  },
  "devDependencies": {
    "@ai-atlaas/pixel-foundry": "^0.1.2",
    "@base-ui/react": "^1.7.0",
    "@cloudflare/workers-types": "^4.20260702.1",
    "@gitbook/cli": "^0.33.6",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "esbuild": "^0.28.2",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "typescript": "^5.9.3"
  }
}
